{
  "HostOptions": {
    "ShutdownTimeout": "00:00:25"
  },
  "MassTransitHostOptions": {
    "WaitUntilStarted": true,
    "StartTimeout": "00:00:30",
    "StopTimeout": "00:00:15"
  },
  "ConnectionStrings": {
    "Default": "",
    "Hangfire": "",
    "Projection": ""
  },
  "EventBusOptions": {
    "ConnectionName": "jogueja",
    "ConnectionString": "",
    "retryLimit": 3,
    "initialInterval": "00:00:05",
    "intervalIncrement": "00:00:10"
  },
  "EnvironmentOptions": {
    "EnvironmentName": "PRODUCTION"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "MassTransit": "Information",
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "Theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "Formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "your-secret-key-here-must-be-at-least-32-characters-long",
    "Issuer": "Jogueja",
    "Audience": "Jogueja-Users",
    "ExpirationMinutes": 60
  }
}
