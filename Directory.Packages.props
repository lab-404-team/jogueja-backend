    <PackageVersion Include="AWSSDK.S3" Version="3.7.415.14" />
    <PackageVersion Include="ClosedXML" Version="0.104.2" />
    <!--CorrelationId-->
    <PackageVersion Include="CorrelationId" Version="3.0.1" />
    <!--Coverlet-->
