<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Packages">
    <!--Amazon-->
    <PackageVersion Include="Amazon.Extensions.Configuration.SystemsManager" Version="6.2.2" />
    <!--Ardalis.SmartEnum-->
